{
  "name": "secondhand",
  "version": "0.1.0",
  "private": true,
  "description": "Cheap browser automation over MCP: Stagehand + Browser Use, driven by an OpenCode Go subscription.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marticols/secondhand.git"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "mcp",
    "browser-automation",
    "stagehand",
    "browser-use",
    "playwright"
  ],
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "3.7.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^4.21.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "typescript": "^7.0.2"
  }
}

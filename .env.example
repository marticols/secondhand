# Model in Stagehand's "<provider>/<model>" form.
STAGEHAND_MODEL_NAME=openai/gpt-4.1-mini

# Key for the selected provider. Falls back to its conventional variable:
# OPENAI_API_KEY, ANTHROPIC_API_KEY, GOOGLE_GENERATIVE_AI_API_KEY (or
# GEMINI_API_KEY), GROQ_API_KEY, CEREBRAS_API_KEY, XAI_API_KEY, MISTRAL_API_KEY,
# DEEPSEEK_API_KEY, TOGETHER_API_KEY, PERPLEXITY_API_KEY.
STAGEHAND_API_KEY=your-key-here

# Optional: point any OpenAI-compatible model at its endpoint. The
# {{sessionId}} placeholder becomes a fresh UUID per browser session.
# STAGEHAND_BASE_URL=
# STAGEHAND_HEADERS={"x-opencode-session":"{{sessionId}}"}

# OpenCode Go is just an OpenAI-compatible endpoint:
# STAGEHAND_MODEL_NAME=openai/deepseek-v4.1-flash
# STAGEHAND_API_KEY=oc_your-key-here
# STAGEHAND_BASE_URL=https://opencode.ai/zen/go/v1
# STAGEHAND_HEADERS={"x-opencode-session":"{{sessionId}}"}

BROWSER_USE_API_KEY=bu_your-key-here
BROWSER_USE_PROFILE_ID=

MCP_HTTP_PORT=3900
MCP_CALL_TIMEOUT_MS=120000
FILES_DIR=./files

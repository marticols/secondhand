OPENCODE_API_KEY=your-key-here
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

STAGEHAND_MODEL_NAME=openai/deepseek-v4.1-flash

BROWSER_USE_API_KEY=bu_your-key-here
BROWSER_USE_PROFILE_ID=

MCP_HTTP_PORT=3900
# Hard ceiling for one tool call (ms). Stagehand's act/observe model calls have no
# timeout of their own, so this is what stops a stalled model from hanging a call.
MCP_CALL_TIMEOUT_MS=120000
